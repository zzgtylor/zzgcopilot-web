{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "zzgcopilot-publisher",
  "main": "workers/publisher/index.ts",
  "compatibility_date": "2026-08-06",
  "compatibility_flags": ["nodejs_compat"],
  "triggers": {
    "crons": ["* * * * *"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "zzgcopilot-db",
      "database_id": "6306be87-8b34-4573-8bc6-9202dd660785"
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}

