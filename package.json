{
  "name": "zzgcopilot-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "pages:build": "opennextjs-cloudflare build && node scripts/pages-postbuild.mjs",
    "preview": "npm run pages:build && opennextjs-cloudflare preview",
    "deploy": "npm run pages:build && wrangler pages deploy",
    "backup:cloudflare": "bash scripts/backup-cloudflare.sh",
    "test": "node --test tests/*.test.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@portabletext/react": "^6.2.0",
    "lucide-react": "^0.441.0",
    "next": "15.5.18",
    "react": "^19",
    "react-dom": "^19",
    "react-markdown": "^9.0.1",
    "remark-gfm": "^4.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240924.0",
    "@opennextjs/cloudflare": "1.19.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.0.1",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "typescript": "^5",
    "wrangler": "^4.86.0"
  }
}
