{
  "name": "zzgcopilot-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "pages:build": "opennextjs-cloudflare build && node scripts/pages-postbuild.mjs",
    "preview": "npm run pages:build && opennextjs-cloudflare preview",
    "deploy": "npm run pages:build && wrangler pages deploy",
    "backup:sanity": "bash scripts/backup-sanity.sh",
