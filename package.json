    "@vercel/speed-insights": "^2.0.0",
    "lucide-react": "^0.441.0",
    "next": "^16.3.0",
    "pg": "^8.23.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^9.0.1",
    "remark-gfm": "^4.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240924.0",
    "@opennextjs/cloudflare": "^1.20.2",
    "@types/node": "^20",
